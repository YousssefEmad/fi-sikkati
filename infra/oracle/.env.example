# Copy to .env on the Oracle VM. Never commit .env.
# Passwords below match infra/compose/postgres/init (first boot). Change later with ALTER ROLE if needed.

APP_ENV=staging
PUBLIC_WEB_URL=https://fi-sikkati.vercel.app
SITE_ADDRESS=:80

POSTGRES_SUPERUSER_PASSWORD=postgres_oracle_change_me
POSTGRES_APP_PASSWORD=fisikkati_app_dev
POSTGRES_MIGRATOR_PASSWORD=fisikkati_migrator_dev

AUTH_JWT_ACTIVE_KID=oracle-1
# Generate on any machine:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# and three 32+ char secrets for pepper/csrf/hash
AUTH_JWT_PRIVATE_KEY=
AUTH_PASSWORD_PEPPER=
AUTH_CSRF_SECRET=
AUTH_HASH_SECRET=

EMAIL_FROM_ADDRESS=no-reply@fisikkati.app
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_SUPER_ADMIN_EMAILS=
