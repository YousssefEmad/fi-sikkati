# Fi Sikkati web — environment template. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets there.

# API origin as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# API origin as seen from the Next.js server (Server Components). Same as above when running
# natively; the compose stack uses the service name.
API_INTERNAL_URL=http://localhost:8000
# Canonical public origin of this web app (metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_TELEMETRY_DISABLED=1
