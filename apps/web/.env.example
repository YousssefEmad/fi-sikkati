# Fi Sikkati web — environment template. Copy to .env.local for local development.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets there.

# The browser talks to this Next.js origin; `/api/*` is rewritten to the FastAPI process so
# `__Host-` session cookies attach to the web origin (ADR-0004). Server Components still call
# the API directly via API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000
# API origin as seen from the Next.js server.
API_INTERNAL_URL=http://localhost:8000
# Canonical public origin of this web app (metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_TELEMETRY_DISABLED=1
