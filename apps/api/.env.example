# Fi Sikkati API — environment template. Copy to .env and adjust. Never commit .env.
# Values below are safe local-development defaults matching infra/compose/docker-compose.yml.
# 127.0.0.1 is used instead of localhost on purpose: on machines with another PostgreSQL bound to
# [::1]:5432, "localhost" may resolve to IPv6 and hit the wrong server.

APP_ENV=development                    # development | test | staging | production
APP_NAME=fi-sikkati-api
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                     # console (dev) | json (staging/production)

# PostgreSQL + PostGIS (asyncpg driver). The app role has DML only (docs/database.md §8).
DATABASE_URL=postgresql+asyncpg://fisikkati_app:fisikkati_app_dev@127.0.0.1:5432/fisikkati
# Used only by `alembic` (DDL role).
MIGRATION_DATABASE_URL=postgresql+asyncpg://fisikkati_migrator:fisikkati_migrator_dev@127.0.0.1:5432/fisikkati

REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
