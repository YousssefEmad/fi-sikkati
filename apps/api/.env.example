# Fi Sikkati API — environment template. Copy to .env and adjust. Never commit .env.
# Values below are safe local-development defaults matching infra/compose/docker-compose.yml.
# 127.0.0.1 is used instead of localhost on purpose: on machines with another PostgreSQL bound to
# [::1]:5432, "localhost" may resolve to IPv6 and hit the wrong server.

# development | test | staging | production
APP_ENV=development
APP_NAME=fi-sikkati-api
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (dev) | json (staging/production)
LOG_FORMAT=console

# PostgreSQL + PostGIS (asyncpg driver). The app role has DML only (docs/database.md §8).
DATABASE_URL=postgresql+asyncpg://fisikkati_app:fisikkati_app_dev@127.0.0.1:5432/fisikkati
# Used only by `alembic` (DDL role).
MIGRATION_DATABASE_URL=postgresql+asyncpg://fisikkati_migrator:fisikkati_migrator_dev@127.0.0.1:5432/fisikkati

REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# --- Authentication secrets (ADR-0004, security.md §1) ----------------------------------------
# Left EMPTY on purpose: `pnpm setup` generates local values, and production values come from the
# platform secret store. Never commit a real value here.
#   AUTH_JWT_PRIVATE_KEY : base64 of a 32-byte Ed25519 seed
#   the other three      : at least 32 characters of random data
AUTH_JWT_ACTIVE_KID=dev-1
AUTH_JWT_PRIVATE_KEY=
AUTH_PASSWORD_PEPPER=
AUTH_CSRF_SECRET=
AUTH_HASH_SECRET=
# Public keys of retired key ids, so tokens signed before a rotation still verify.
# Format: kid:base64publickey,kid:base64publickey
AUTH_JWT_RETIRED_PUBLIC_KEYS=

# --- Authentication tuning (defaults match security.md; override only with a reason) ----------
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_REFRESH_ABSOLUTE_TTL_DAYS=90
# AUTH_PASSWORD_MIN_LENGTH=10
# AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
# AUTH_PASSWORD_RESET_TTL_MINUTES=60
# Rate limits are "<events>/<window seconds>" (security.md §7).
# AUTH_LOGIN_RATE_LIMIT_PER_IP=10/900
# AUTH_LOGIN_RATE_LIMIT_PER_IDENTIFIER=5/900
# AUTH_REGISTER_RATE_LIMIT=5/3600
# AUTH_FORGOT_RATE_LIMIT_PER_IDENTIFIER=3/3600
# AUTH_FORGOT_RATE_LIMIT_PER_IP=10/3600
# AUTH_EMAIL_RESEND_RATE_LIMIT=3/3600
# Argon2id: ~250 ms on production hardware. Lower values are for CI only.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=4

# --- Accounts and legal (BR-ACC-07, BR-ACC-08) ------------------------------------------------
# ACCOUNTS_DELETION_GRACE_DAYS=14
# ACCOUNTS_MINIMUM_AGE_YEARS=18
LEGAL_TERMS_VERSION=2026-10-01
LEGAL_PRIVACY_VERSION=2026-10-01

# --- Outbound email (OD-019: SMTP behind the EmailSender port; Mailpit locally) ----------------
# A real-looking domain is required: reserved names (.local, .test) fail address validation.
EMAIL_FROM_ADDRESS=no-reply@fisikkati.app
EMAIL_FROM_NAME=Fi Sikkati
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Comma-separated. Matching accounts get ADMIN / SUPER_ADMIN on register, login, and API startup.
# BOOTSTRAP_ADMIN_EMAILS=ops@example.com
# BOOTSTRAP_SUPER_ADMIN_EMAILS=owner@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_USE_STARTTLS=false
# Phone alerts. Generate a key pair and set both before production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@fisikkati.app
# Real SMS. Required in production. Leave empty locally and the code is shown on screen.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS_FROM=

# --- Object storage (ADR-0013; local MinIO from infra/compose) --------------------------------
S3_ENDPOINT=http://127.0.0.1:9100
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_password
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=public-media
S3_PRIVATE_BUCKET=private-documents
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://127.0.0.1:9100/public-media

# --- Verification & vehicles (OD-003/009/024 approved) ----------------------------------------
# VERIFICATION_DOCUMENT_RETENTION_DAYS=30
# VERIFICATION_REVIEW_SLA_HOURS=48
# VEHICLES_MAX_PER_DRIVER=3
# UPLOADS_MAX_DOCUMENT_BYTES=10485760
# MAPBOX_ACCESS_TOKEN=
# MAPBOX_PUBLIC_TOKEN=
# TRIPS_MAX_PASSENGER_SEATS=7
# BOOKINGS_MAX_SEATS_PER_REQUEST=7
# BOOKINGS_CANCELLATION_WINDOW_DAYS=90
# BOOKINGS_LATE_CANCEL_MINUTES=120

# --- Chat, notifications, safety, AI (Phases 7–10) -------------------------------------------
# CHAT_RATE_LIMIT_PER_USER=30/60
# CHAT_POST_COMPLETION_OPEN_HOURS=24
# NOTIFICATIONS_TRIP_REMINDER_HOURS=24
# NOTIFICATIONS_STARTING_SOON_MINUTES=120
# RATINGS_WINDOW_DAYS=14
# REPORTS_PER_USER_PER_DAY=10/86400
# AI_ENABLED=false
# AI_PROVIDER=rules
# AI_RATE_LIMIT_PER_USER=30/3600
# TRIPS_EXPIRE_GRACE_MINUTES=60
# TRIPS_START_WINDOW_MINUTES=30
# MATCHING_CORRIDOR_WIDTH_METERS=1000
# PRIVACY_LOCATION_BLUR_METERS=500
