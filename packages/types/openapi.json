{
  "components": {
    "schemas": {
      "FieldError": {
        "description": "A validation problem attached to a specific input field.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details document with Fi Sikkati extensions.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PublicConfig": {
        "additionalProperties": false,
        "description": "Non-sensitive runtime configuration the web client needs before login.",
        "properties": {
          "apiVersion": {
            "title": "Apiversion",
            "type": "string"
          },
          "defaultLocale": {
            "title": "Defaultlocale",
            "type": "string"
          },
          "defaultTimezone": {
            "title": "Defaulttimezone",
            "type": "string"
          },
          "environment": {
            "enum": [
              "development",
              "test",
              "staging",
              "production"
            ],
            "title": "Environment",
            "type": "string"
          },
          "supportedLocales": {
            "items": {
              "type": "string"
            },
            "title": "Supportedlocales",
            "type": "array"
          }
        },
        "required": [
          "environment",
          "apiVersion",
          "supportedLocales",
          "defaultLocale",
          "defaultTimezone"
        ],
        "title": "PublicConfig",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Community ride-sharing and route-matching platform. Drivers publish planned trips; passengers find people already going their way.",
    "title": "Fi Sikkati API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/platform/config": {
      "get": {
        "operationId": "platform_get_public_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error (RFC 9457 Problem Details with machine-readable `code`)"
          }
        },
        "summary": "Public runtime configuration",
        "tags": [
          "platform"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Public runtime configuration and feature flags.",
      "name": "platform"
    }
  ]
}
