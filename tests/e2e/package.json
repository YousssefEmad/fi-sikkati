{
  "name": "@fi-sikkati/e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end tests for Fi Sikkati (run against a running API + web)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "install-browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@fi-sikkati/config": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
